<rml>
<head>
	<title>Title Menu</title>
	<style>
		body {
			margin: 0px;
			width: 100%;
			height: 100%;
			font-family: OCRAStd;
			color: #FFFFFF;
		}
		#ui_canvas {
			position: absolute;
			left: 0px;
			top: 0px;
			width: 100%;
			height: 100%;
		}
		.title-button {
			position: absolute;
			display: block;
			font-family: OCRAStd;
			font-size: 48px;
			font-weight: normal;
			text-align: left;
			color: #FFFFFF;
			background-color: rgba(0, 0, 0, 0);
		}
		.title-button:hover,
		.ui-nav-selected {
			color: rgb(71, 255, 105);
			background-color: rgba(255, 255, 255, 0.12);
		}
	</style>
</head>
<body data-rml-ui-document="1" data-ui-layout="scaled" data-canvas-width="1920" data-canvas-height="1080" data-preview-scale="1">
	<div id="ui_canvas">
		<div id="start_button" class="title-button" data-rml-editor="1" data-type="Button" data-x="120.000000" data-y="400.000000" data-width="280.000000" data-height="64.000000" data-z="0" data-visible="true" data-locked="false" data-opacity="1.000000" data-bg="#00000000" data-text="Start" data-text-color="#FFFFFFFF" data-font-size="48.000000" data-font-family="OCRAStd" data-bold="false" data-image="" data-target-tag="Player" data-on-click="StartGame" style="position: absolute; left: 120.00px; top: 400.00px; width: 280.00px; height: 64.00px; font-size: 48.00px; font-weight: normal; text-align: left;">Start</div>
		<div id="setting_button" class="title-button" data-rml-editor="1" data-type="Button" data-x="120.000000" data-y="480.000000" data-width="360.000000" data-height="64.000000" data-z="1" data-visible="true" data-locked="false" data-opacity="1.000000" data-bg="#00000000" data-text="Settings" data-text-color="#FFFFFFFF" data-font-size="48.000000" data-font-family="OCRAStd" data-bold="false" data-image="" data-target-tag="Player" data-on-click="ShowSetting" style="position: absolute; left: 120.00px; top: 480.00px; width: 360.00px; height: 64.00px; font-size: 48.00px; font-weight: normal; text-align: left;">Settings</div>
		<div id="ranking_button" class="title-button" data-rml-editor="1" data-type="Button" data-x="120.000000" data-y="560.000000" data-width="360.000000" data-height="64.000000" data-z="2" data-visible="true" data-locked="false" data-opacity="1.000000" data-bg="#00000000" data-text="Ranking" data-text-color="#FFFFFFFF" data-font-size="48.000000" data-font-family="OCRAStd" data-bold="false" data-image="" data-target-tag="Player" data-on-click="ShowRanking" style="position: absolute; left: 120.00px; top: 560.00px; width: 360.00px; height: 64.00px; font-size: 48.00px; font-weight: normal; text-align: left;">Ranking</div>
		<div id="credit_button" class="title-button" data-rml-editor="1" data-type="Button" data-x="120.000000" data-y="640.000000" data-width="320.000000" data-height="64.000000" data-z="3" data-visible="true" data-locked="false" data-opacity="1.000000" data-bg="#00000000" data-text="Credit" data-text-color="#FFFFFFFF" data-font-size="48.000000" data-font-family="OCRAStd" data-bold="false" data-image="" data-target-tag="Player" data-on-click="ShowCredit" style="position: absolute; left: 120.00px; top: 640.00px; width: 320.00px; height: 64.00px; font-size: 48.00px; font-weight: normal; text-align: left;">Credit</div>
		<div id="exit_button" class="title-button" data-rml-editor="1" data-type="Button" data-x="120.000000" data-y="720.000000" data-width="240.000000" data-height="64.000000" data-z="4" data-visible="true" data-locked="false" data-opacity="1.000000" data-bg="#00000000" data-text="Exit" data-text-color="#FFFFFFFF" data-font-size="48.000000" data-font-family="OCRAStd" data-bold="false" data-image="" data-target-tag="Player" data-on-click="ExitGame" style="position: absolute; left: 120.00px; top: 720.00px; width: 240.00px; height: 64.00px; font-size: 48.00px; font-weight: normal; text-align: left;">Exit</div>
	</div>
</body>
</rml>
