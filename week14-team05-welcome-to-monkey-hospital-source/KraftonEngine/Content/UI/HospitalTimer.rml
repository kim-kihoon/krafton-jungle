<rml>
<head>
	<title>Hospital Timer</title>
	<style>
		body {
			margin: 0px;
			width: 100%;
			height: 100%;
			font-family: OCRAStd;
			font-size: 16px;
		}
		#ui_canvas {
			position: absolute;
			left: 0px;
			top: 0px;
			width: 100%;
			height: 100%;
		}
		#timer_display {
			position: absolute;
			right: 1.6667%;
			top: 2.963%;
			display: block;
			color: rgb(71, 255, 105);
			font-family: OCRAStd;
			font-size: 1.125em;
			text-align: right;
			line-height: 1.35;
			background-color: rgba(0, 0, 0, 0);
		}
	</style>
</head>
<body data-rml-ui-document="1" data-ui-layout="hud" data-canvas-width="1920" data-canvas-height="1080" data-preview-scale="1">
	<div id="ui_canvas">
		<div id="timer_display">0:00</div>
	</div>
</body>
</rml>
