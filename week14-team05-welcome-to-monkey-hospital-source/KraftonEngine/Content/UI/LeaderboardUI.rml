<rml>
<head>
	<title>Leaderboard</title>
	<style>
		body {
			margin: 0px;
			width: 100%;
			height: 100%;
			font-family: OCRAStd;
			color: #FFFFFF;
			background-color: rgba(0, 0, 0, 0);
		}
		#overlay {
			position: absolute;
			left: 0px;
			top: 0px;
			width: 960px;
			height: 1080px;
			background-color: rgba(0, 0, 0, 0.88);
		}
		#panel_title {
			position: absolute;
			left: 120px;
			top: 150px;
			font-size: 56px;
			color: rgb(71, 255, 105);
		}
		#leaderboard_header {
			position: absolute;
			left: 120px;
			top: 250px;
			width: 760px;
			height: 36px;
			font-size: 26px;
			white-space: pre;
			color: rgb(71, 255, 105);
		}
		.leaderboard-row {
			position: absolute;
			left: 120px;
			width: 760px;
			height: 30px;
			font-size: 24px;
			white-space: pre;
			color: #FFFFFF;
		}
		#leaderboard_empty {
			position: absolute;
			left: 120px;
			top: 340px;
			font-size: 30px;
			color: #FFFFFF;
		}
		.title-button {
			position: absolute;
			display: block;
			font-family: OCRAStd;
			font-size: 40px;
			font-weight: normal;
			text-align: left;
			color: #FFFFFF;
			background-color: rgba(0, 0, 0, 0);
		}
		.title-button:hover,
		.ui-nav-selected {
			color: rgb(71, 255, 105);
			background-color: rgba(255, 255, 255, 0.12);
		}
	</style>
</head>
<body data-rml-ui-document="1" data-ui-layout="scaled" data-canvas-width="1920" data-canvas-height="1080" data-preview-scale="1">
	<div id="overlay">
		<div id="panel_title">Ranking</div>
		<div id="leaderboard_header">RANK   TIME       NAME</div>
		<div id="leaderboard_empty">No clear records yet.</div>
		<div id="leaderboard_row_1" class="leaderboard-row" style="top: 310px;"></div>
		<div id="leaderboard_row_2" class="leaderboard-row" style="top: 340px;"></div>
		<div id="leaderboard_row_3" class="leaderboard-row" style="top: 370px;"></div>
		<div id="leaderboard_row_4" class="leaderboard-row" style="top: 400px;"></div>
		<div id="leaderboard_row_5" class="leaderboard-row" style="top: 430px;"></div>
		<div id="leaderboard_row_6" class="leaderboard-row" style="top: 460px;"></div>
		<div id="leaderboard_row_7" class="leaderboard-row" style="top: 490px;"></div>
		<div id="leaderboard_row_8" class="leaderboard-row" style="top: 520px;"></div>
		<div id="leaderboard_row_9" class="leaderboard-row" style="top: 550px;"></div>
		<div id="leaderboard_row_10" class="leaderboard-row" style="top: 580px;"></div>
		<div id="leaderboard_row_11" class="leaderboard-row" style="top: 610px;"></div>
		<div id="leaderboard_row_12" class="leaderboard-row" style="top: 640px;"></div>
		<div id="leaderboard_row_13" class="leaderboard-row" style="top: 670px;"></div>
		<div id="leaderboard_row_14" class="leaderboard-row" style="top: 700px;"></div>
		<div id="leaderboard_row_15" class="leaderboard-row" style="top: 730px;"></div>
		<div id="leaderboard_row_16" class="leaderboard-row" style="top: 760px;"></div>
		<div id="leaderboard_row_17" class="leaderboard-row" style="top: 790px;"></div>
		<div id="leaderboard_row_18" class="leaderboard-row" style="top: 820px;"></div>
		<div id="leaderboard_row_19" class="leaderboard-row" style="top: 850px;"></div>
		<div id="leaderboard_row_20" class="leaderboard-row" style="top: 880px;"></div>
		<div id="leaderboard_back_button" class="title-button" data-rml-editor="1" data-type="Button" data-x="120.000000" data-y="950.000000" data-width="240.000000" data-height="56.000000" data-z="0" data-visible="true" data-locked="false" data-opacity="1.000000" data-bg="#00000000" data-text="Back" data-text-color="#FFFFFFFF" data-font-size="40.000000" data-font-family="OCRAStd" data-bold="false" data-image="" data-target-tag="Player" data-on-click="ClosePopup" style="position: absolute; left: 120.00px; top: 950.00px; width: 240.00px; height: 56.00px; font-size: 40.00px; font-weight: normal; text-align: left;">Back</div>
	</div>
</body>
</rml>
