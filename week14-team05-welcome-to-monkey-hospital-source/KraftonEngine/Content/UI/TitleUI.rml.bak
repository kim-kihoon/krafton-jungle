<rml>
<head>
	<title>Hospital Timer</title>
	<style>
		body {
			margin: 0px;
			width: 100%;
			height: 100%;
			font-family: OCRAStd;
		}
		#ui_canvas {
			position: absolute;
			left: 0px;
			top: 0px;
			width: 100%;
			height: 100%;
		}
		#timer_display {
			position: absolute;
			right: 32px;
			top: 32px;
			display: block;
			color: rgb(71, 255, 105);
			font-family: OCRAStd;
			font-size: 18px;
			text-align: right;
			line-height: 1.35;
			background-color: rgba(0, 0, 0, 0);
		}
	</style>
</head>
<body data-rml-ui-document="1" data-canvas-width="1920" data-canvas-height="1080" data-preview-scale="1">
	<div id="ui_canvas">
		
	</div>

    <div id="text_1" data-ui-editor="text" style="position: absolute; left: 120.00px; top: 400.00px; width: 200.00px; height: 11.00px; font-size: 48.00px; font-weight: normal; text-align: left; color: #FFFFFF;">Start</div>

    <div id="text_2" data-ui-editor="text" style="position: absolute; left: 120.00px; top: 480.00px; width: 433.00px; height: 40.00px; font-size: 48.00px; font-weight: normal; text-align: left; color: #FFFFFF;">Setting</div>

    <div id="text_4" data-ui-editor="text" style="position: absolute; left: 120.00px; top: 560.00px; width: 200.00px; height: 40.00px; font-size: 48.00px; font-weight: normal; text-align: left; color: #FFFFFF;">Credit
</div>

    <div id="text_3" data-ui-editor="text" style="position: absolute; left: 120.00px; top: 640.00px; width: 200.00px; height: 40.00px; font-size: 48.00px; font-weight: normal; text-align: left; color: #FFFFFF;">Exit</div>
</body>
</rml>
