<rml>
<head>
	<title>Pause Menu</title>
	<style>
		body {
			margin: 0px;
			width: 100%;
			height: 100%;
			font-family: OCRAStd;
			color: #FFFFFF;
			background-color: rgba(0, 0, 0, 0);
		}
		#ui_canvas {
			position: absolute;
			left: 0px;
			top: 0px;
			width: 1920px;
			height: 1080px;
		}
		#pause_blocker {
			position: absolute;
			left: 0px;
			top: 0px;
			width: 1920px;
			height: 1080px;
			background-color: rgba(0, 0, 0, 0);
		}
		.title-button {
			position: absolute;
			display: block;
			font-family: OCRAStd;
			font-size: 48px;
			font-weight: normal;
			text-align: left;
			color: #FFFFFF;
			background-color: rgba(0, 0, 0, 0);
		}
		#resume_button {
			left: 120px;
			top: 360px;
			width: 360px;
			height: 64px;
		}
		#restart_button {
			left: 120px;
			top: 440px;
			width: 360px;
			height: 64px;
		}
		#exit_to_title_button {
			left: 120px;
			top: 520px;
			width: 520px;
			height: 64px;
		}
		#resume_button:hover,
		#restart_button:hover,
		#exit_to_title_button:hover,
		.title-button:hover,
		.ui-nav-selected {
			color: rgb(71, 255, 105);
			background-color: rgba(255, 255, 255, 0.12);
		}
	</style>
</head>
<body data-rml-ui-document="1" data-ui-layout="scaled" data-canvas-width="1920" data-canvas-height="1080" data-preview-scale="1">
	<div id="ui_canvas">
		<div id="pause_blocker"></div>
		<div id="resume_button" class="title-button" data-type="Button" data-target-tag="Player" data-on-click="ResumeGame">Resume</div>
		<div id="restart_button" class="title-button" data-type="Button" data-target-tag="Player" data-on-click="RestartGame">Restart</div>
		<div id="exit_to_title_button" class="title-button" data-type="Button" data-target-tag="Player" data-on-click="ExitToTitle">Exit to Title</div>
	</div>
</body>
</rml>
