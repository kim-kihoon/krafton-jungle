<rml>
<head>
	<title>Hospital Control Prompt</title>
	<style>
		body {
			margin: 0px;
			width: 100%;
			height: 100%;
			font-family: OCRAStd;
			font-size: 16px;
		}
		#ui_canvas {
			position: absolute;
			left: 0px;
			top: 0px;
			width: 100%;
			height: 100%;
		}
		#control_prompt_panel {
			position: absolute;
			right: 1.6667%;
			bottom: 2.963%;
			display: block;
			text-align: right;
		}
		#ammo_display {
			display: none;
			color: rgb(71, 255, 105);
			font-family: OCRAStd;
			font-size: 1.75em;
			line-height: 1.35;
			background-color: rgba(0, 0, 0, 0);
			margin-bottom: 2px;
		}
		#control_prompt {
			display: block;
			color: rgb(71, 255, 105);
			font-family: OCRAStd;
			font-size: 1.125em;
			text-align: right;
			line-height: 1.35;
			white-space: pre-line;
			background-color: rgba(0, 0, 0, 0);
		}
	</style>
</head>
<body data-rml-ui-document="1" data-ui-layout="hud" data-canvas-width="1920" data-canvas-height="1080" data-preview-scale="1">
	<div id="ui_canvas">
		<div id="control_prompt_panel">
			<div id="ammo_display">3</div>
			<div id="control_prompt">[LMB] Shoot<br/>[Space] Camera</div>
		</div>
	</div>
</body>
</rml>
